# ZTEIST 环境变量模板 —— 复制为 .env 并填真实值（.env 已被 gitignore）

# 服务端口（AIF 占 3000/3001/3002，ZTEIST 用 3003）
PORT=3003

# 登录态 token 签名密钥（生产必须改成足够长的随机字符串）
AUTH_SECRET=change-me-to-a-long-random-string

# 数据库文件路径（默认 ./data/zteist.db，一般不用改）
# DB_PATH=/opt/zteist/data/zteist.db

# 发验证码邮件（Resend）。不配则只打日志、不真发（开发/灰度可留空）
RESEND_API_KEY=
